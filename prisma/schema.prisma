// Prisma schema for Dee's Resin Craft & Souvenirs Collection
// Dev uses SQLite for zero-config; production should use PostgreSQL
// (change provider + DATABASE_URL, then run `prisma migrate dev`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Auth (NextAuth / Auth.js) ---
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("customer") // "customer" | "student" | "admin"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  enrollments   Enrollment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Commerce ---
model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  // pesewas (GHS * 100) for safe integer math
  priceMinor  Int
  currency    String   @default("GHS")
  category    String   // "resin" | "gift-box" | "tshirt" | "mug" | "candle"
  stock       Int      @default(0)
  customizable Boolean @default(false)
  images      String   // JSON array of URLs
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  caption   String?
  imageUrl  String
  tag       String?  // "resin" | "candle" | "custom-print"
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// --- Courses / Students area ---
model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String
  priceMinor  Int      // 0 = free
  currency    String   @default("GHS")
  coverImage  String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  lessons     Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int     @default(0)
  videoUrl    String? // direct mp4 or HLS/Mux playback ID
  pdfUrl      String? // served via signed /api/downloads/[id]
  durationSec Int?
  preview     Boolean @default(false) // viewable without enrolment

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  status    String   @default("active") // "active" | "revoked"
  source    String   @default("purchase") // "purchase" | "manual" | "free"
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// --- Orders ---
model Order {
  id               String   @id @default(cuid())
  userId           String?
  email            String
  phone            String?
  shippingAddress  String?  // JSON
  totalMinor       Int
  currency         String   @default("GHS")
  status           String   @default("pending") // pending | paid | failed | refunded | fulfilled
  paystackRef      String?  @unique
  paystackAuthUrl  String?
  notes            String?
  needsReview      Boolean  @default(false) // true when fulfilment couldn't decrement stock cleanly
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String?
  courseId    String?
  kind        String // "product" | "course"
  title       String // snapshot
  priceMinor  Int    // snapshot
  quantity    Int    @default(1)
  customization String? // JSON (e.g. engraving text, uploaded image URL)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}
