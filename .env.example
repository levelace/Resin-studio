# --- Core ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# --- Database (SQLite for dev, Postgres recommended for prod) ---
# Dev default:
DATABASE_URL="file:./dev.db"
# Prod example (Neon / Supabase / Railway):
# DATABASE_URL="postgresql://user:password@host:5432/resin?sslmode=require"

# --- Paystack (Ghana) ---
# Sign up at https://dashboard.paystack.com and use TEST keys first.
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
NEXT_PUBLIC_PAYSTACK_CURRENCY=GHS

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (magic links, order receipts). Use any SMTP provider. ---
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Dee's Resin Craft & Souvenirs Collection <no-reply@deesresincraft.gh>"

# --- Admin emails (comma-separated, full access to admin dashboard) ---
ADMIN_EMAILS=owner@example.com

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Dee's Resin Craft & Souvenirs Collection"
